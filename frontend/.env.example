# Development default (uses Vite dev server proxy / local Nginx reverse proxy):
# VITE_API_BASE_URL=/api/v1
#
# Production (Cloudflare Pages frontend + Railway API backend):
# When frontend is deployed to Cloudflare Pages (https://example.com)
# and backend API is deployed to Railway (https://api.example.com):
# VITE_API_BASE_URL=https://api.example.com/api/v1
#
# VITE_* values are bundled into the client-side JavaScript bundle — never put secrets here.
VITE_API_BASE_URL=/api/v1
