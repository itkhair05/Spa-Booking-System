# ==============================================================================
# TIKEY SPA — Environment Variables Template (Docker / Production-like)
# ==============================================================================
# Copy this file to .env and configure values before starting Docker Compose:
#   cp .env.example .env
# Never commit .env or actual production credentials to version control.
# ==============================================================================

# Database Configuration (MySQL Container)
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=spabooking_dev
DB_USER=root
DB_PASSWORD=change-me-db-password
MYSQL_HOST_PORT=3307

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
DEV_OWNER_PASSWORD=change-me-owner-password
DEV_STAFF_PASSWORD=change-me-staff-password

# JWT Security (Must be at least 256 bits / 32 characters)
JWT_SECRET=change-me-jwt-secret-min-256-bits-secure-key-string-here
JWT_EXPIRATION_MS=86400000

# File Upload Storage Directory (Mapped to uploads_data volume)
APP_UPLOAD_DIR=/app/uploads

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# VNPay Sandbox Configuration
VNPAY_TMN_CODE=VMWY8Z1F
VNPAY_HASH_SECRET=change-me-vnpay-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/dat-lich/callback
VNPAY_IPN_URL=
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Rate Limiting (In-memory token bucket)
RATE_LIMIT_ENABLED=true
